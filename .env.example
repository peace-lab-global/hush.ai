# ============================================================
# 冥想老师 AI 分身 — 本地开发配置
# 复制为 .env 后填入实际值:  cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
# 留空 = 使用本地 SQLite（零配置，适合开发测试）
# 生产环境使用 PostgreSQL:
# MEDITATION_POSTGRES_URL=postgresql://hush:hush123@localhost:5432/hush_meditation

# ChromaDB 持久化目录（留空则纯内存模式）
# MEDITATION_CHROMA_DIR=./chroma_data

# ---------- JWT ----------
MEDITATION_JWT_SECRET=dev-secret-change-me-in-production

# ---------- 微信小程序 ----------
# MEDITATION_WX_APPID=wx1234567890abcdef
# MEDITATION_WX_SECRET=your-wechat-app-secret

# ---------- LLM ----------
# 默认 LLM 提供商: openai | deepseek | zhipu
MEDITATION_DEFAULT_LLM_PROVIDER=openai
MEDITATION_DEFAULT_LLM_MODEL=gpt-4o-mini

# OpenAI
MEDITATION_OPENAI_API_KEY=sk-your-openai-key
# MEDITATION_OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（备选）
# MEDITATION_DEEPSEEK_API_KEY=your-deepseek-key
# MEDITATION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MEDITATION_DEEPSEEK_MODEL=deepseek-chat

# 智谱（备选）
# MEDITATION_ZHIPU_API_KEY=your-zhipu-key

# Kimi（月之暗面 Moonshot）
# MEDITATION_KIMI_API_KEY=sk-your-kimi-key
# MEDITATION_KIMI_BASE_URL=https://api.moonshot.cn/v1
# MEDITATION_KIMI_MODEL=moonshot-v1-8k

# ---------- Embedding ----------
MEDITATION_EMBEDDING_PROVIDER=openai
MEDITATION_EMBEDDING_MODEL=text-embedding-3-small
# MEDITATION_EMBEDDING_API_KEY=sk-xxx   （默认复用 OPENAI_API_KEY）
# MEDITATION_EMBEDDING_BASE_URL=

# ---------- 记忆与知识库 ----------
MEDITATION_MEMORY_TOP_K=5
MEDITATION_KNOWLEDGE_TOP_K=3
MEDITATION_CONVERSATION_MAX_TURNS=20

# ---------- 服务 ----------
MEDITATION_HOST=0.0.0.0
MEDITATION_PORT=8000
MEDITATION_DEBUG=true
